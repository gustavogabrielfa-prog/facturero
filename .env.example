# Supabase Dashboard > Project Settings > API (o "Connect" arriba a la derecha)

# Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública: "anon public" o "Publishable key" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# --- GitHub (solo para publicar con `npm run github:publish`, no lo usa la app) ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=facturero
GITHUB_PRIVATE=true
GITHUB_BRANCH_PROD=main
GITHUB_BRANCH_DEV=develop

# --- Cloudflare Pages (solo para `npm run deploy:dev` / `npm run deploy:prod`, no lo usa la app) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT=facturero
